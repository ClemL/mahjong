# Multiplayer is off unless a table password is set. Everyone joining a room
# types this, so pick something you are happy saying out loud.
MAHJONG_ROOM_PASSWORD=

# Where rooms live. Without these the store falls back to process memory, which
# is fine locally but NOT in production: serverless invocations do not share
# memory, so rooms appear to vanish at random.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
