# Where the shared table lives. Without these the store falls back to process
# memory, which is fine locally but NOT in production: serverless invocations do
# not share memory, so the table appears to vanish at random.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Only read when REQUIRE_PASSWORD is turned back on in src/server/rooms.ts.
# Seats are currently open to anyone with the link.
MAHJONG_ROOM_PASSWORD=
